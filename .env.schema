# The app's environment: every variable server.ts and web/ read, with its type and default. varlock validates
# it on startup; set values in .env (git-ignored) or the shell. src/config.ts maps it for the code.
# @defaultRequired=infer @defaultSensitive=false @redact
# @generateTsTypes(path=./src/env.d.ts, processEnv=none)
# ---

# --- Model (src/models.ts) ---
# Unset: picked from whichever API key is set (anthropic, then vercel, then openai); with none, a faux/echo model answers.
# @type=enum(anthropic, vercel, openai, ollama)
MODEL_PROVIDER=
# Overrides the provider's default model.
MODEL_ID=
# Ollama's server; Ollama reports the model's tools, vision, thinking and context size at startup.
# @type=url
OLLAMA_URL=http://192.168.1.20:11434
# Read by pi-ai itself from process.env.
# @sensitive @type=string(startsWith=sk-ant-)
ANTHROPIC_API_KEY=
# Vercel AI Gateway; read by pi-ai itself from process.env.
# @sensitive @type=string(startsWith=vck_)
AI_GATEWAY_API_KEY=
# Read by pi-ai itself from process.env.
# @sensitive @type=string(startsWith=sk-)
OPENAI_API_KEY=

# --- Langfuse (src/langfuse.ts): traces are exported when both keys are set; `pnpm langfuse:up` writes them to .env ---
LANGFUSE_PUBLIC_KEY=
# @sensitive
LANGFUSE_SECRET_KEY=
# @type=url
LANGFUSE_BASE_URL=http://localhost:3000

# --- Server (server.ts) ---
# @type=port
SERVER_PORT=4000
# Seats at once: Conversations live in the server, chats included. A shell or desktop Seat also takes one of
# MAX_SHELLS or MAX_DESKTOPS.
# @type=number(isInt=true, min=1)
MAX_SEATS=10
# Shell sandboxes at once.
# @type=number(isInt=true, min=0)
MAX_SHELLS=3
# Desktop sandboxes at once.
# @type=number(isInt=true, min=0)
MAX_DESKTOPS=1
# A conversation idle this long is closed and its sandbox removed.
# @type=duration
CONVERSATION_IDLE_TIMEOUT=30m
# @type=duration
CONVERSATION_SWEEP_INTERVAL=1m
# SSE streams never close on their own; do not wait long for them before removing sandboxes.
# @type=duration
SHUTDOWN_TIMEOUT=1s

# --- Paths (server.ts) ---
# Conversations persist here (WAL SQLite).
EFFECT_PI_DB=data/effect-pi.sqlite
SKILLS_DIR=skills
SCREENSHOTS_DIR=screenshots
# Attachments' originals and prepared files (their metadata is in EFFECT_PI_DB).
ATTACHMENTS_DIR=data/attachments

# --- Object storage (src/storage/object-store.ts, docs/plans/object-storage.md) ---
# `local` keeps the directories above; `s3` stores objects in S3 (SeaweedFS locally, `pnpm seaweed:up`).
# @type=enum(local, s3)
STORAGE=local
# Where workspace files live; s3-copied copies them through the object store.
# @type=enum(docker-volume, s3-copied)
WORKSPACE_STORAGE=docker-volume
# The S3 endpoint; SeaweedFS's gateway port.
# @type=url
S3_ENDPOINT=http://127.0.0.1:8333
# Required when STORAGE=s3; docker/seaweedfs/init-env.ts generates them.
# @sensitive
S3_ACCESS_KEY_ID=
# @sensitive
S3_SECRET_ACCESS_KEY=
# Days before objects in the screenshots bucket expire (a lifecycle rule set at startup).
# @type=number(isInt=true, min=1)
SCREENSHOT_TTL_DAYS=30

# --- Attachments (src/attachments/, docs/plans/attachments.md) ---
# @type=number(isInt=true, min=1)
ATTACHMENT_MAX_FILE_MB=25
# Files one message can take.
# @type=number(isInt=true, min=1)
ATTACHMENT_MAX_FILES=10
# All unsent uploads together.
# @type=number(isInt=true, min=1)
ATTACHMENT_MAX_UNSENT_MB=200
# @type=number(isInt=true, min=1)
ATTACHMENT_MAX_PDF_PAGES=300
# Decoded pixels of an image, in millions.
# @type=number(isInt=true, min=1)
ATTACHMENT_MAX_IMAGE_MEGAPIXELS=40
# Reading one file (in a worker thread) is stopped after this long, or past this much memory.
# @type=duration
ATTACHMENT_EXTRACT_TIMEOUT=30s
# @type=number(isInt=true, min=64)
ATTACHMENT_EXTRACT_MEMORY_MB=512
# Files read at once.
# @type=number(isInt=true, min=1)
ATTACHMENT_EXTRACT_CONCURRENCY=2
# Uploads no message took are deleted after this long.
# @type=duration
ATTACHMENT_UNSENT_TTL=24h
# Characters of document text a message carries inline, all its attachments together; the agent reads the rest.
# @type=number(isInt=true, min=0)
ATTACHMENT_INLINE_CHARS=30000
# Characters read_attachment returns per call.
# @type=number(isInt=true, min=1000)
ATTACHMENT_READ_CHARS=20000
# Keep attachment text in traces; only its size otherwise.
# @type=boolean
TRACE_ATTACHMENT_TEXT=false

# --- MCP (src/mcp.ts) ---
# How long to wait for each MCP server when the agents start.
# @type=duration
MCP_CONNECT_TIMEOUT=10s

# --- Web search (src/web-search/): a `web_search` tool on the host, present only when SEARXNG_URL is set ---
# The local SearXNG (`pnpm searxng:up`), or another instance's URL. Unset: conversations get no web extension.
# @type=url
SEARXNG_URL=
# One search request is cut off after this long.
# @type=duration
WEB_SEARCH_TIMEOUT=10s
# Searches at once; every one reaches several engines from this one host.
# @type=number(isInt=true, min=1)
WEB_SEARCH_CONCURRENCY=4
# `auto` lets SearXNG detect the language, or a code such as es-AR.
WEB_SEARCH_LANGUAGE=auto
# SearXNG's safesearch: 0 none, 1 moderate, 2 strict.
# @type=number(isInt=true, min=0, max=2)
WEB_SEARCH_SAFESEARCH=1

# --- Web console (web/) ---
# @type=port
WEB_PORT=3001
# Where the console's /api rewrite sends requests.
# @type=url
API_URL=http://127.0.0.1:${SERVER_PORT}
