# Plain http on the local network: Caddy keeps the Host header and sets X-Forwarded-Host, both of which the server
# checks against PUBLIC_URL's URLs. It overwrites X-Forwarded-* sent by clients, so they cannot claim another host.
{
	admin off
	auto_https off
}

:{$LAN_PORT} {
	# First: the console's /api rewrite cannot carry WebSockets (the Shell tab and the desktop).
	@sockets path_regexp ^/api/conversations/[^/]+/(shell|desktop)$
	reverse_proxy @sockets 127.0.0.1:4000

	reverse_proxy 127.0.0.1:3001
}
