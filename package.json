{
  "name": "effect-pi",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "exports": {
    "./api": "./src/server/api.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.ts",
    "server": "node --env-file-if-exists=.env server.ts",
    "dev:server": "node --watch --env-file-if-exists=.env server.ts",
    "typecheck": "tsc",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm --filter web check",
    "prepare": "lefthook install",
    "test:docker": "DOCKER_TESTS=1 vitest run",
    "test:integration": "INTEGRATION_TESTS=1 vitest run",
    "sandbox:build": "docker build -t effect-pi/sandbox-shell -f docker/sandbox/shell.Dockerfile docker/sandbox && docker build -t effect-pi/sandbox-desktop -f docker/sandbox/desktop.Dockerfile docker/sandbox",
    "langfuse:up": "node docker/langfuse/init-env.ts && docker compose -f docker/langfuse/docker-compose.yml -p langfuse up -d",
    "langfuse:down": "docker compose -f docker/langfuse/docker-compose.yml -p langfuse down",
    "dev:web": "pnpm --filter web dev",
    "dev": "pnpm run \"/^dev:(server|web)$/\""
  },
  "dependencies": {
    "@earendil-works/chord": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-durable": "^1.1.0",
    "@earendil-works/pi-env": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@effect/platform-node": "4.0.2",
    "effect": "^4.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.1",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
