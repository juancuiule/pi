# The web console's environment: the keys it needs from the root .env.schema and .env, plus the PORT Next listens on.
# Only these are imported, so the root's API keys and secrets never reach the Next process.
# @defaultRequired=infer @defaultSensitive=false
# @import(../, pick=[WEB_PORT, API_URL, SERVER_PORT])
# @generateTsTypes(path=./env.d.ts, processEnv=none)
# ---

# Next reads PORT before it loads any .env file, so `varlock run` sets it from WEB_PORT.
# @type=port
PORT=${WEB_PORT}
